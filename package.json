{
  "name": "@omnidotdev/thornberry",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "exports": {
    "./base.css": "./build/base.css",
    "./*": {
      "types": "./build/registry/thornberry/components/*.d.ts",
      "import": "./build/registry/thornberry/components/*.js"
    }
  },
  "files": [
    "build"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "fumadocs-mdx && tsc --noEmit && vite build",
    "start": "node .output/server/index.mjs",
    "check": "fumadocs-mdx && biome check --diagnostic-level=error",
    "format": "biome format --write",
    "lint": "biome lint",
    "registry:build": "bun src/scripts/build-registry.ts && biome format --write public/r",
    "build:lib": "NODE_ENV=production bun src/scripts/build-lib.ts",
    "test": "bun test --conditions production",
    "knip": "knip-bun",
    "prepare": "husky",
    "release": "changeset publish"
  },
  "dependencies": {
    "@internationalized/date": "^3.10.1",
    "@omnidotdev/cadence": "github:omnidotdev/cadence#9352906",
